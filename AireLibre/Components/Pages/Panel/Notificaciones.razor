@*
    Notificaciones.razor — Vista 12: los avisos para el profesor (/panel/notificaciones).

    QUÉ MUESTRA: dos clases de aviso, y vale la pena tener claro que NO
    funcionan igual.

      1. CUPOS SEPARADOS — están GUARDADOS. Los crea ReservaService en el mismo
         momento en que se guarda una reserva. Se pueden marcar como leídos,
         porque su estado persiste.

      2. PAGOS QUE VENCEN MAÑANA — se CALCULAN al abrir la pantalla, comparando
         la fecha de próximo pago de cada suscripción contra la de mañana.
         NO se guardan y por eso NO se pueden marcar como leídos: no hay dónde
         anotar la marca.

    POR QUÉ ESA DIFERENCIA: un aviso de pago guardado ayer diría hoy "vence
    mañana" cuando el plazo ya se venció. Calculándolo, siempre corresponde al
    día en que se consulta. Un cupo separado, en cambio, es un hecho que ocurrió
    en un momento concreto y no cambia: ese sí se guarda.
    Ver Notificacion.cs y ClienteService.AvisosDePagoManana().
*@
@page "/panel/notificaciones"
@layout PanelLayout
@inherits PaginaPanel
@inject DatosService Datos
@inject ClienteService Clientes

<PageTitle>Notificaciones — STRONGBODY</PageTitle>

<div class="panel-titulo">
    <div>
        <span class="eyebrow">Avisos</span>
        <h1>Notificaciones</h1>
    </div>

    @if (SinLeer > 0)
    {
        <button type="button" class="btn btn--contorno" @onclick="MarcarTodasLeidas">
            Marcar las @SinLeer como leídas
        </button>
    }
</div>

@if (Sesion.HaySesion)
{
    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="aviso" role="status">
            <p>@_mensaje</p>
        </div>
    }

    @* ------------------------------------------------------------------
       PAGOS QUE VENCEN MAÑANA — calculados, no guardados
    ------------------------------------------------------------------ *@
    <h2>Pagos que vencen mañana</h2>

    @if (AvisosDePago.Count == 0)
    {
        <div class="vacio" style="margin-bottom: 2.5rem;">
            <p>A nadie le vence el plan mañana. Nada que recordar hoy.</p>
        </div>
    }
    else
    {
        <p class="texto-secundario texto-chico">
            Se calculan cada vez que abres esta pantalla, así que siempre
            corresponden a hoy. Por eso no se marcan como leídos.
        </p>

        <div class="grid" style="margin-bottom: 2.5rem;">
            @foreach (var aviso in AvisosDePago)
            {
                <div class="aviso aviso--error">
                    <p>
                        <strong>Pago por vencer</strong> — @aviso.Mensaje
                    </p>
                </div>
            }
        </div>
    }

    @* ------------------------------------------------------------------
       CUPOS SEPARADOS — guardados, se marcan como leídos
    ------------------------------------------------------------------ *@
    <h2>Cupos separados</h2>

    @if (AvisosDeCupo.Count == 0)
    {
        <div class="vacio">
            <p>Todavía no ha entrado ninguna reserva.</p>
        </div>
    }
    else
    {
        <p class="texto-secundario texto-chico">
            @SinLeer sin leer de @AvisosDeCupo.Count en total. Se genera uno por
            cada cupo que se separa desde el sitio público.
        </p>

        <div class="grid" style="margin-top: 1rem;">
            @foreach (var aviso in AvisosDeCupo)
            {
                @* Los leídos se atenúan en vez de esconderse: siguen siendo el
                   historial de reservas, solo que ya vistos. *@
                <div class="tarjeta" style="@(aviso.Leida ? "opacity: 0.55;" : "")">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
                        <div style="flex: 1; min-width: 240px;">
                            <span class="eyebrow" style="margin-bottom: 0.35rem;">
                                @aviso.FechaHora.ToString("d 'de' MMMM, h:mm tt", Espanol)
                            </span>
                            <p style="margin: 0;">@aviso.Mensaje</p>
                        </div>

                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            @if (aviso.Leida)
                            {
                                <span class="distintivo distintivo--neutro">Leída</span>
                            }
                            else
                            {
                                <span class="distintivo distintivo--alerta">Nueva</span>
                                <button type="button" class="btn btn--contorno btn--chico"
                                        @onclick="() => MarcarLeida(aviso.Id)">
                                    Marcar leída
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Espanol = new("es-CO");

    private string _mensaje = string.Empty;

    /// <summary>
    /// Los avisos guardados de cupo separado, el más reciente arriba. Se leen
    /// del almacén en cada render, así que aparecen solos cuando alguien
    /// reserva sin tener que refrescar.
    /// </summary>
    private List<Notificacion> AvisosDeCupo =>
        Datos.Notificaciones
            .Where(n => n.Tipo == TipoNotificacion.CupoSeparado)
            .OrderByDescending(n => n.FechaHora)
            .ToList();

    /// <summary>
    /// Los avisos de pago, CALCULADOS al vuelo por el servicio. No están en el
    /// almacén: ver el encabezado del archivo.
    /// </summary>
    private List<Notificacion> AvisosDePago => Clientes.AvisosDePagoManana();

    private int SinLeer => AvisosDeCupo.Count(n => !n.Leida);

    // --- Acciones -------------------------------------------------------------

    /// <summary>
    /// Marca un aviso como leído. Es un cambio de una sola propiedad sobre un
    /// objeto que ya existe, así que se hace directo sobre el almacén sin pasar
    /// por un servicio: no hay ninguna regla de negocio que validar.
    /// </summary>
    private void MarcarLeida(int notificacionId)
    {
        var aviso = Datos.Notificaciones.FirstOrDefault(n => n.Id == notificacionId);
        if (aviso is null) return;

        aviso.Leida = true;
        _mensaje = string.Empty;
    }

    private void MarcarTodasLeidas()
    {
        var cuantas = SinLeer;

        foreach (var aviso in Datos.Notificaciones.Where(n => !n.Leida))
        {
            aviso.Leida = true;
        }

        _mensaje = cuantas == 1
            ? "Se marcó 1 notificación como leída."
            : $"Se marcaron {cuantas} notificaciones como leídas.";
    }
}
